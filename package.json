{
  "name": "@ziyarago/ui",
  "version": "0.20.5",
  "description": "ZiyaraGo UI — glass design system for Umrah and Hajj products. OKLCH tokens, two palettes, dark and light, RTL, Thmanyah. One framework-neutral core with Vue 3, Nuxt and React adapters, 102 free components and 6 page templates (more in @ziyarago/ui-pro).",
  "keywords": [
    "ui",
    "design-system",
    "components",
    "vue",
    "react",
    "glassmorphism",
    "rtl",
    "arabic",
    "oklch",
    "umrah",
    "hajj",
    "ziyarago",
    "nuxt"
  ],
  "type": "module",
  "license": "MIT",
  "author": "ZiyaraGo <dev@ziyarago.com>",
  "homepage": "https://ziyara.vip",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ziyarago/ui.git"
  },
  "bugs": {
    "url": "https://github.com/ziyarago/ui/issues"
  },
  "sideEffects": [
    "**/*.css",
    "./src/i18n/index.js",
    "./src/i18n/components/*.js"
  ],
  "main": "./src/core/index.js",
  "module": "./src/core/index.js",
  "types": "./types/core.d.ts",
  "exports": {
    ".": {
      "types": "./types/core.d.ts",
      "default": "./src/core/index.js"
    },
    "./vue": {
      "types": "./types/vue.d.ts",
      "default": "./src/vue/index.js"
    },
    "./react": {
      "types": "./types/react.d.ts",
      "default": "./src/react/index.js"
    },
    "./theme": {
      "types": "./types/theme.d.ts",
      "default": "./src/theme.js"
    },
    "./style.css": "./dist/style.css",
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./tokens/tokens.json",
    "./assets/*": "./assets/*",
    "./package.json": "./package.json",
    "./nuxt": {
      "types": "./types/nuxt.d.ts",
      "default": "./src/nuxt/module.mjs"
    },
    "./manifest.json": "./dist/manifest.json",
    "./llms.txt": "./dist/llms.txt",
    "./llms-full.txt": "./dist/llms-full.txt",
    "./meta": {
      "types": "./types/meta.d.ts",
      "default": "./src/meta/index.js"
    },
    "./vue/global": {
      "types": "./types/vue-global.d.ts",
      "default": "./src/vue/global.js"
    },
    "./resolver": {
      "types": "./types/resolver.d.ts",
      "default": "./src/resolver.js"
    },
    "./i18n": {
      "types": "./types/i18n.d.ts",
      "default": "./src/i18n/index.js"
    },
    "./internal": {
      "types": "./types/internal.d.ts",
      "default": "./src/internal.js"
    }
  },
  "files": [
    "dist",
    "types",
    "assets/fonts",
    "tokens",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "src",
    "docs/INTEGRATION.md"
  ],
  "scripts": {
    "types": "node scripts/types.mjs",
    "icons": "node scripts/icons.mjs",
    "build": "node scripts/i18n-index.mjs && node scripts/build.mjs && node scripts/types.mjs && node scripts/manifest.mjs",
    "check": "node scripts/check.mjs && node scripts/check-meta.mjs && node scripts/i18n-index.mjs",
    "test": "npm run test:unit && npm run test:ssr && npm run test:browser",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:ssr": "node --test tests/ssr/*.test.mjs",
    "test:browser": "node tests/browser/run.mjs && node tests/browser/interactions.mjs",
    "prepack": "npm run build && npm run check",
    "pack:dry": "npm pack --dry-run",
    "test:behaviour": "node tests/behaviour/audit.mjs && node tests/behaviour/flows.mjs",
    "test:types": "node scripts/typecheck-fixtures.mjs",
    "a11y": "node scripts/a11y.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@nuxt/kit": ">=3.0.0",
    "react": ">=18",
    "react-dom": ">=18",
    "vue": ">=3.5"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "@nuxt/kit": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@nuxt/kit": "^3.21.11",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@types/react": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "axe-core": "^4.14.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "esbuild": "^0.28.2",
    "lucide-static": "^0.460.0",
    "puppeteer-core": "^23.11.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "semantic-release": "^24.2.9",
    "typescript": "5.9",
    "vite": "^6.4.4",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  },
  "typesVersions": {
    "*": {
      "vue": [
        "types/vue.d.ts"
      ],
      "vue/global": [
        "types/vue-global.d.ts"
      ],
      "react": [
        "types/react.d.ts"
      ],
      "theme": [
        "types/theme.d.ts"
      ],
      "nuxt": [
        "types/nuxt.d.ts"
      ],
      "resolver": [
        "types/resolver.d.ts"
      ],
      "meta": [
        "types/meta.d.ts"
      ],
      "i18n": [
        "types/i18n.d.ts"
      ],
      "internal": [
        "types/internal.d.ts"
      ]
    }
  }
}
