#!/bin/sh
# Forced command for the CI deploy key (installed as /usr/local/bin/ziyara-deploy-shell).
# The key can ONLY run: receive <ver> (tar stream on stdin) | activate <ver> | rollback | status. Nothing else, no shell.
set -eu
BASE=/var/www/ziyara-vip
REL=$BASE/releases
KEEP=5
cmd="${SSH_ORIGINAL_COMMAND:-}"
verok() { printf '%s' "$1" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+(-[A-Za-z0-9.]+)?$'; }

case "$cmd" in
  "receive "*)
    v="${cmd#receive }"; verok "$v" || { echo "bad version" >&2; exit 2; }
    [ -e "$REL/$v" ] && { echo "release $v already exists" >&2; exit 3; }
    tmp="$REL/.incoming-$v"; rm -rf "$tmp"; mkdir -p "$tmp"
    if tar -xzf - -C "$tmp" --no-same-owner --no-same-permissions; then
      [ -f "$tmp/index.html" ] || { rm -rf "$tmp"; echo "no index.html in archive" >&2; exit 4; }
      mv "$tmp" "$REL/$v"; echo "received $v ($(find "$REL/$v" -type f | wc -l) files)"
    else rm -rf "$tmp"; echo "extract failed" >&2; exit 5; fi ;;
  "activate "*)
    v="${cmd#activate }"; verok "$v" || { echo "bad version" >&2; exit 2; }
    [ -d "$REL/$v" ] || { echo "no such release" >&2; exit 3; }
    prev=$(readlink "$BASE/current" 2>/dev/null || true)
    [ -n "$prev" ] && ln -sfn "$prev" "$BASE/previous"
    ln -sfn "$REL/$v" "$BASE/current.new" && mv -Tf "$BASE/current.new" "$BASE/current"
    echo "active: $v"
    # keep the newest $KEEP releases, never the active or the previous one
    cur=$(readlink "$BASE/current"); pre=$(readlink "$BASE/previous" 2>/dev/null || true)
    ls -1dt "$REL"/[0-9]* 2>/dev/null | tail -n +$((KEEP + 1)) | while read -r d; do [ "$d" != "$cur" ] && [ "$d" != "$pre" ] && rm -rf "$d"; done ;;
  rollback)
    [ -L "$BASE/previous" ] || { echo "no previous release" >&2; exit 3; }
    cur=$(readlink "$BASE/current"); pre=$(readlink "$BASE/previous")
    ln -sfn "$pre" "$BASE/current.new" && mv -Tf "$BASE/current.new" "$BASE/current"; ln -sfn "$cur" "$BASE/previous"
    echo "rolled back to $(basename "$pre")" ;;
  status)
    echo "current:  $(readlink "$BASE/current" 2>/dev/null || echo none)"; echo "previous: $(readlink "$BASE/previous" 2>/dev/null || echo none)"; ls -1t "$REL" | head -10 ;;
  *) echo "command not allowed" >&2; exit 1 ;;
esac
